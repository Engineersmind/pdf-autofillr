# =============================================================================
# PDF Mapper Module - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# -----------------------------------------------------------------------------
# Storage  (MAPPER_* vars — all optional, defaults shown)
# -----------------------------------------------------------------------------
# Backend: local | aws | azure | gcp  (default: local)
MAPPER_STORAGE=local

# Local paths (used when MAPPER_STORAGE=local)
MAPPER_INPUT_PATH=/app/data/input
MAPPER_OUTPUT_PATH=/app/data/output
MAPPER_CACHE_PATH=/app/data/cache
MAPPER_PROCESSING_PATH=/tmp/processing

# AWS S3  (used when MAPPER_STORAGE=aws)
MAPPER_S3_BUCKET=your-pdf-bucket
MAPPER_S3_PREFIX=pdf-autofiller

# Azure Blob Storage  (used when MAPPER_STORAGE=azure)
MAPPER_AZURE_CONTAINER=your-container
MAPPER_AZURE_PREFIX=pdf-autofiller

# GCP Cloud Storage  (used when MAPPER_STORAGE=gcp)
MAPPER_GCS_BUCKET=your-gcs-bucket
MAPPER_GCS_PREFIX=pdf-autofiller

# -----------------------------------------------------------------------------
# Cloud Credentials
# -----------------------------------------------------------------------------

# AWS  (when MAPPER_STORAGE=aws)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Azure  (when MAPPER_STORAGE=azure — connection string OR account+SAS)
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_SAS_TOKEN=your-sas-token

# GCP  (when MAPPER_STORAGE=gcp)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id

# -----------------------------------------------------------------------------
# LLM API Keys  (set the one matching your llm_model in config.ini)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Azure OpenAI  (when using azure/* model)
AZURE_API_KEY=your-azure-openai-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# Ollama  (when using ollama/* model — default assumes local host)
OLLAMA_API_BASE=http://localhost:11434

# Override LLM model at runtime (overrides config.ini [mapping] llm_model)
# LLM_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# RAG Module  (second mapper — only needed when use_second_mapper=true in config.ini)
# -----------------------------------------------------------------------------
RAG_API_URL=http://localhost:8001/predict
RAG_API_KEY=your-rag-api-key

# -----------------------------------------------------------------------------
# Java Filler  (optional — only needed if jars are in a non-standard location)
# -----------------------------------------------------------------------------
# PDF_AUTOFILLER_JAR_DIR=/path/to/jars

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_KEY=your-api-key
